# Copy this file to .env and fill in local values. Do not commit .env.

SERVER_PORT=8080

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/jwtstarter
SPRING_DATASOURCE_USERNAME=jwtstarter
SPRING_DATASOURCE_PASSWORD=changeme

# Generate with: openssl rand -base64 48
APP_JWT_SECRET=
APP_JWT_ISSUER=jwt-security-starter
APP_JWT_ACCESS_TTL=15m
APP_JWT_REFRESH_TTL=14d

APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

APP_MAX_FAILED_LOGINS=5
APP_LOCKOUT_DURATION=15m
APP_LOGIN_RATE_LIMIT=20
APP_LOGIN_RATE_WINDOW=15m

# logging (default, prints messages to the log) or smtp
APP_MAIL_MODE=logging
APP_MAIL_FROM=noreply@localhost
APP_BASE_URL=http://localhost:8080

# Optional SMTP (used when APP_MAIL_MODE=smtp). Mailpit is fine for local development.
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_AUTH=false
SPRING_MAIL_STARTTLS=false

# Optional bootstrap administrator. Left empty, no admin user is created.
APP_ADMIN_EMAIL=
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD=
APP_ADMIN_FIRST_NAME=Admin
APP_ADMIN_LAST_NAME=User

# Enable only when APP_MAIL_MODE=smtp and you want /actuator/health to check the mail server.
APP_MAIL_HEALTH=false
